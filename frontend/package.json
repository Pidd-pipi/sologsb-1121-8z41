{
  "name": "gbforestplot-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview --port 5173",
    "test:merge": "esbuild scripts/merge-smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/merge-smoke.mjs && node node_modules/.tmp/merge-smoke.mjs",
    "test:render": "esbuild scripts/render-smoke.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp/render-smoke.cjs && node node_modules/.tmp/render-smoke.cjs"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "antd": "^5.20.6",
    "dexie": "^4.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
